[ext_resource type="Script" uid="uid://cfiljbox47ovp" path="res://scripts/resources/lunch_dialogue_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
speaker_name = "Peter"
opening_text = "Hey, you hear about that new project starting next week? The boss is really focused on it. I heard if someone lands the bid, the reward is pretty huge. But the pressure's no joke. Just so you know."
choice_a_text = "That actually sounds like a great opportunity."
choice_b_text = "I just want to get through my internship first."
choice_a_feedback = "Nice! I like ambition."
choice_b_feedback = "Come on, you're playing it way too safe."
